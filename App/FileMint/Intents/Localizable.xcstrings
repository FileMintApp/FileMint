    "Review a file draft in FileMint. Only choosing Create saves a file. For empty input, select Empty Content.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review a file draft in FileMint. Only choosing Create saves a file. For empty input, select Empty Content."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 FileMint 中检查草稿，只有点击创建才会保存文件。空白文件请选择“空内容”。"
          }
        }
      }
    },
    "Show or focus FileMint Quick Search. This action keeps an unfinished query and never toggles the panel closed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show or focus FileMint Quick Search. This action keeps an unfinished query and never toggles the panel closed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示或聚焦 FileMint 快捷搜索，保留未完成的查询，不会将面板切换为关闭。"
          }
        }
      }
    },
    "Open draft ${name} using ${template}": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
