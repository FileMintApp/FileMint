{
  "schemaVersion": 1,
  "cases": [
    {
      "id": "create-empty-text",
      "name": "create plain text file in empty folder",
      "templateID": "plain-text",
      "requestedFileName": null,
      "existingFiles": [],
      "expect": {
        "fileName": "Untitled.txt",
        "content": {
          "mode": "exact",
          "value": ""
        }
      }
    },
    {
      "id": "increment-text",
      "name": "increment text file when default name already exists",
      "templateID": "plain-text",
      "requestedFileName": null,
      "existingFiles": [
        {
          "name": "Untitled.txt",
          "content": "Preserve Untitled.txt\n"
        }
      ],
      "expect": {
        "fileName": "Untitled 2.txt",
        "content": {
          "mode": "exact",
          "value": ""
        }
      }
    },
    {
      "id": "render-markdown-title",
      "name": "create markdown file with rendered title",
      "templateID": "markdown",
      "requestedFileName": null,
      "existingFiles": [],
      "expect": {
        "fileName": "Untitled.md",
        "content": {
          "mode": "exact",
          "value": "# Untitled.md\n\n"
        }
      }
    },
    {
      "id": "sanitize-json-filename",
      "name": "sanitize requested filename separators",
      "templateID": "json",
      "requestedFileName": "api/config.json",
      "existingFiles": [],
      "expect": {
        "fileName": "api-config.json",
        "content": {
          "mode": "exact",
          "value": "{}\n"
        }
      }
    },
    {
      "id": "increment-swift",
      "name": "increment custom swift filename",
      "templateID": "swift",
      "requestedFileName": "Model.swift",
      "existingFiles": [
        {
          "name": "Model.swift",
          "content": "Preserve Model.swift\n"
        },
        {
          "name": "Model 2.swift",
          "content": "Preserve Model 2.swift\n"
        }
      ],
      "expect": {
        "fileName": "Model 3.swift",
        "content": {
          "mode": "exact",
          "value": "import Foundation\n\n"
        }
      }
    }
  ]
}
